# Build artifact: 30MB, regenerated by deploy/pi/package-for-pi.sh on demand.
# Tracking it puts a fresh 30MB blob in history on every rebuild, and the file
# is only ever copied from the dev machine to the Pi by hand.
deploy/pi/vajron-gcs-pi.tar.gz
