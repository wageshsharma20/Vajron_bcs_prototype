[Unit]
# Turns the MAVLink stream into something a browser can read.
# The GCS page has no way to open a UDP socket, so without this it can only
# ever show its canned demo replay.
Description=Vajron GCS MAVLink bridge
After=network.target vajron-router.service
Wants=vajron-router.service

[Service]
Type=simple
# Belt and braces with the in-process line buffering: without unbuffered
# output, journalctl shows nothing until the process exits.
Environment=PYTHONUNBUFFERED=1
# python3 ships with Raspberry Pi OS and the bridge imports nothing outside the
# standard library, so this needs no install step and no internet in the field.
#
# 14551, not 14550: QGroundControl binds 14550 to listen for vehicles. If QGC
# ever runs on this same Pi, a bridge on 14550 would fail to start.
# Receive-only as shipped. To let the GCS command the aircraft, append
#   --command-link udpout:127.0.0.1:14560 --command-token <secret>
# (14560 is the router's command endpoint -- see mavlink-router.conf)
# and, only if you want ARM/TAKEOFF from the GCS as well, --allow-arm.
# Needs pymavlink:  sudo pip3 install pymavlink
# VAJRON_SIGNING_ARGS is filled in by install-on-pi.sh: the signing key file if
# one was set up, nothing otherwise. --require-signed is never added for you --
# run bridge/provision_signing.py first and add it only if that reports the
# aircraft signs its telemetry, or the display goes blank.
ExecStart=/usr/bin/python3 /opt/vajron-gcs/bridge/mavlink_bridge.py \
          --udp-port 14551 --http-port 8082 --drone-id DRONE-01 VAJRON_SIGNING_ARGS
Restart=always
RestartSec=2
User=vajron-gcs-user-placeholder

[Install]
WantedBy=multi-user.target
