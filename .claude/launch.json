{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gcs-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8085"
      ],
      "port": 8085,
      "autoPort": false
    },
    {
      "name": "gcs-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "dist",
        "--single"
      ],
      "autoPort": true
    }
  ]
}
